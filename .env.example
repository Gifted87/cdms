# CDMS Configuration

# LLM Provider Configuration (ollama | gemini)
LLM_PROVIDER="ollama"

# Gemini API Configuration (Mandatory for Cognitive Bridge)
# The system utilizes the Gemini 2.5 Flash Lite model for high-dimensional semantic indexing.
# Provide a comma-separated list of keys for sequential rotation.
# GEMINI_API_KEYS="AIzaSy...,AQ.Ab8RN6..."

# WebSocket Administration Token
# CMS_ADMIN_TOKEN="your_secure_token"

# ACMS Portability Loader Configuration
# ACMS_PORT="4000"
# ACMS_NODE_NAME="primary_cortex"
# ACMS_DATA_DIR="./memory_cartridges/default"
